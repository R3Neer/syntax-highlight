(* MUD 1.0 — normative concrete grammar.
   Upper-case terminals come from mud-lexico.ebnf or the contextual
   classifier described in 07-lexicon.md. NEWLINE is classified as
   TERMINATOR or continuation whitespace by the grammatical-context
   boundary contract in 08-concrete-grammar.md before these productions. *)

mud-input
    ::= mud-file | part-file ;

part-file
    ::= layout , [ uses-declaration , { required-separation , uses-declaration } , [ required-separation ] ] , EOF ;

uses-declaration
    ::= "uses" , mud-path ;

part-only-directive
    ::= "part" , "only" ;

mud-file
    ::= layout
        , [ part-only-directive , required-separation ]
        , [ file-metadata-assignment , { required-separation , file-metadata-assignment } , required-separation ]
        , [ using-file-body | declaration-file-body ]
        , EOF
        ;

using-file-body
    ::= using-declaration
        , { required-separation , using-declaration }
        , [ required-separation
            , top-level-declaration
            , { required-separation , top-level-declaration }
          ]
        , [ required-separation ]
        ;

declaration-file-body
    ::= top-level-declaration
        , { required-separation , top-level-declaration }
        , [ required-separation ]
      ;

using-declaration
    ::= "using" , mud-path , [ "." , "*" ] ;

top-level-declaration
    ::= thing-declaration
      | alias-declaration
      | family-declaration
      | magnitude-declaration
      | boolean-rule-declaration
      | reactive-rule-declaration
      | always-rule-declaration
      | action-declaration
      | subaction-declaration
      | look-declaration
      | sublook-declaration
      | message-declaration
      | submessage-declaration
      | test-declaration
      | part-start-declaration
      ;

(* ------------------------------------------------------------------ *)
(* Names and references                                               *)
(* ------------------------------------------------------------------ *)

mud-path
    ::= lower-name , { "." , lower-name } ;

qualified-name
    ::= identifier , { "." , identifier } ;

nominal-name      ::= identifier ;
lower-name        ::= identifier ;
member-name       ::= identifier ;
field-name        ::= identifier ;
metadata-name     ::= identifier | "for" | "on" | "given" ;
collection-key-path    ::= field-name , { "." , field-name } ;
role-name         ::= identifier ;
given-name        ::= identifier ;
component-name    ::= identifier ;
variable-name     ::= identifier ;
declaration-reference ::= qualified-name ;
type-reference    ::= qualified-name ;

identifier ::= IDENTIFIER ;

(* PascalCase/lowerCamelCase and forbidden words are static rules. *)

(* ------------------------------------------------------------------ *)
(* Declaraciones nominales                                             *)
(* ------------------------------------------------------------------ *)

ancestor-clause
    ::= "as" , ancestor-list ;

ancestor-list
    ::= nominal-type , { "," , nominal-type }
      | "[" , nominal-type , { "," , nominal-type } , "]" ;

generic-parameter-group
    ::= HEADER_WITH , type-parameter-list , [ "as" , generic-bound-list ] ;

type-parameter-list
    ::= nominal-name , { "," , nominal-name }
      | "[" , nominal-name , { "," , nominal-name } , "]" ;

generic-bound-list
    ::= nominal-type , { "," , nominal-type }
      | "[" , nominal-type , { "," , nominal-type } , "]" ;

nominal-type
    ::= type-reference | generic-type-application | "(" , nominal-type , ")" ;

generic-constructor
    ::= type-reference | "Interval" ;

generic-type-application
    ::= explicit-generic-type-application | postfix-generic-type-application ;

explicit-generic-type-application
    ::= generic-constructor , "with" , generic-argument-list ;

postfix-generic-type-application
    ::= generic-argument-head
        , { generic-constructor | callable-type-suffix }
        , generic-constructor ;

generic-argument-head
    ::= type-reference | explicit-generic-type-application
      | reflected-type | product-type
      | "(" , generic-union-argument , ")" ;

grouped-postfix-generic-type-application
    ::= ( product-type | "(" , generic-union-argument , ")" )
        , { generic-constructor | callable-type-suffix }
        , generic-constructor ;

expression-generic-suffix
    ::= { callable-type-suffix } , generic-constructor ;

generic-argument-list
    ::= generic-argument , { "," , generic-argument } ;

generic-argument
    ::= generic-argument-head , { generic-constructor | callable-type-suffix } ;

generic-union-argument
    ::= declared-type , { "|" , declared-type } ;

generic-call-suffix
    ::= "with" , generic-argument-list ;

generic-family-member
    ::= explicit-generic-type-application , "." , member-name ;

structural-type-comparison
    ::= type-expression , structural-type-equality-operator , type-expression ;

structural-type-equality-operator
    ::= "===" | "!==" ;

thing-declaration
    ::= [ "abstract" ] , "thing" , nominal-name
        , [ ancestor-clause ]
        , { generic-parameter-group }
        , [ thing-body ]
        ;

thing-body
    ::= "{" , declaration-layout
        , [ metadata-assignment , { required-separation , metadata-assignment } , required-separation ]
        , [ thing-body-declaration
            , { required-separation , thing-body-declaration }
            , [ required-separation ]
          ]
        , "}"
        ;

thing-body-declaration
    ::= field-declaration
      | thing-initializer
      ;

thing-initializer
    ::= field-name , "=" , value-body
      ;

file-metadata-assignment
    ::= "~" , metadata-name
        , ( "=" , constant-expression
          | ":" , stored-type-expression , [ "=" , constant-expression ]
          )
        ;

metadata-assignment
    ::= "~" , metadata-name
        , ( "=" , value-body
          | ":" , stored-type-expression , [ "=" , value-body ]
          | [ derived-value-shape ] , ":=" , value-body
          )
        ;

metadata-body
    ::= "{" , declaration-layout
        , [ metadata-assignment
            , { required-separation , metadata-assignment }
            , [ required-separation ]
          ]
        , "}"
        ;

descriptor-value-body
    ::= ( value-expression , [ metadata-body ]
      | "{" , declaration-layout
        , [ metadata-assignment
            , { required-separation , metadata-assignment }
            , required-separation
          ]
        , value-block
        , [ required-separation ]
        , "}" ) , { otherwise-clause }
        ;

alias-declaration
    ::= [ "abstract" ] , "alias" , nominal-name
        , [ ancestor-clause ]
        , { generic-parameter-group }
        , [ alias-definition ]
        ;

alias-definition
    ::= ":=" , type-expression
        , [ "{" , declaration-layout
            , [ metadata-assignment
                , { required-separation , metadata-assignment }
                , required-separation
              ]
            , [ operator-declaration , { required-separation , operator-declaration } , [ required-separation ] ]
            , "}"
          ]
      | structural-alias-body
        ;

structural-alias-body
    ::= "{" , declaration-layout
        , [ metadata-assignment , { required-separation , metadata-assignment } , required-separation ]
        , [ alias-body-declaration
            , { required-separation , alias-body-declaration }
            , [ required-separation ]
          ]
        , "}"
        ;

alias-body-declaration
    ::= component-declaration
      | calculated-field-declaration
      | inherited-default-override
      | operator-declaration
        ;

operator-declaration
    ::= operator-operand , overload-binary-operator , operator-operand
        , [ ":" , type-expression ] , ":=" , descriptor-value-body
      | overload-unary-operator , operator-operand
        , [ ":" , type-expression ] , ":=" , descriptor-value-body ;

operator-operand
    ::= variable-name | "(" , variable-name , ":" , type-expression , ")" ;

overload-unary-operator ::= "+" | "-" ;

overload-binary-operator ::= "+" | "-" | "*" | "/" | "%" | "|" | "&" | "^" | "--" ;

component-declaration
    ::= "let" , component-name , ":" , stored-type-expression
        , ( "=" , descriptor-value-body | [ metadata-body ] )
        ;

inherited-default-override
    ::= component-name , "=" , value-body ;

family-declaration
    ::= [ "ordered" ] , "family" , nominal-name
        , { generic-parameter-group }
        , "{" , declaration-layout
        , [ metadata-assignment , { required-separation , metadata-assignment } , required-separation ]
        , { family-data-declaration , required-separation }
        , family-member
        , { "," , declaration-layout , family-member }
        , [ required-separation ]
        , "}"
        ;

family-data-declaration
    ::= stored-family-data-declaration
      | calculated-family-data-declaration
      ;

stored-family-data-declaration
    ::= field-name , ":" , stored-type-expression
        , ( "=" , descriptor-value-body | [ metadata-body ] )
        ;

calculated-family-data-declaration
    ::= "let" , field-name , [ derived-value-shape ] , ":=" , descriptor-value-body ;

family-member
    ::= member-name , [ family-member-body ] ;

family-member-body
    ::= "{" , declaration-layout
        , [ metadata-assignment
            , { required-separation , metadata-assignment }
            , required-separation
          ]
        , [ family-member-entry
            , { required-separation , family-member-entry }
            , [ required-separation ]
          ]
        , "}"
        ;

family-member-entry
    ::= family-data-assignment
      ;

family-data-assignment
    ::= field-name , "=" , value-body ;

(* ------------------------------------------------------------------ *)
(* Magnitudes and units                                                *)
(* ------------------------------------------------------------------ *)

magnitude-declaration
    ::= base-magnitude-declaration
      | derived-magnitude-declaration
      | point-magnitude-declaration
      ;

base-magnitude-declaration
    ::= "magnitude" , nominal-name
        , [ ":" , declared-type ]
        , [ "in" , interval-expression ]
        , magnitude-body
        ;

derived-magnitude-declaration
    ::= "magnitude" , nominal-name
        , [ ":" , declared-type ]
        , [ "in" , interval-expression ]
        , ":=" , dimension-expression
        , [ derived-unit-body ]
        ;

point-magnitude-declaration
    ::= "magnitude" , nominal-name
        , "point" , "over" , type-reference
        , [ "in" , point-domain ]
        , point-magnitude-body
        ;

point-domain
    ::= interval-expression , [ "cycle" ] ;

magnitude-body
    ::= "{" , declaration-layout
        , [ metadata-assignment , { required-separation , metadata-assignment } , required-separation ]
        , [ root-unit-declaration
            , { required-separation , alternative-unit-declaration }
            , [ required-separation ]
          ]
        , "}"
        ;

derived-unit-body
    ::= "{" , declaration-layout
        , [ metadata-assignment , { required-separation , metadata-assignment } , required-separation ]
        , [ alternative-unit-declaration
            , { required-separation , alternative-unit-declaration }
            , [ required-separation ]
          ]
        , "}"
        ;

point-magnitude-body
    ::= "{" , declaration-layout
        , [ metadata-assignment
            , { required-separation , metadata-assignment }
            , [ required-separation ]
          ]
        , "}"
        ;

root-unit-declaration
    ::= "root" , "unit" , unit-name , unit-body ;

alternative-unit-declaration
    ::= "unit" , unit-name , ":=" , quantity-expression , unit-body ;

unit-name ::= identifier ;

unit-body
    ::= "{" , declaration-layout
        , [ metadata-assignment
            , { required-separation , metadata-assignment }
            , [ required-separation ]
          ]
        , "}"
        ;

dimension-expression
    ::= dimension-factor , { ( "*" | "/" ) , dimension-factor } ;

dimension-factor
    ::= type-reference
      | "(" , dimension-expression , ")"
      ;

(* ------------------------------------------------------------------ *)
(* Fields and types                                                     *)
(* ------------------------------------------------------------------ *)

field-declaration
    ::= stored-field-declaration
      | calculated-field-declaration
      ;

stored-field-declaration
    ::= ( "let" | "mut" ) , field-name , [ stored-value-shape ]
        , "=" , descriptor-value-body ;

calculated-field-declaration
    ::= "let" , field-name , [ derived-value-shape ] , ":=" , descriptor-value-body ;

public-field-declaration
    ::= "let" , field-name , [ derived-value-shape ] , ":=" , descriptor-value-body ;

derived-value-shape
    ::= ":" , type-expression
      | "in" , type-alternative-domain , [ collection-specification ]
      | collection-specification
        ;

stored-value-shape
    ::= ":" , stored-type-expression
      | "in" , type-alternative-domain , [ collection-specification ]
      | collection-specification ;

type-inference-hole
    ::= "_" ;

stored-type-expression
    ::= stored-union-type-expression
        , ( { collection-specification } | stored-dictionary-type )
        ;

stored-union-type-expression
    ::= stored-type-alternative , { "|" , stored-type-alternative }
        ;

stored-type-alternative
    ::= stored-declared-type , [ "in" , type-alternative-domain ]
      | "(" , stored-type-expression , ")"
        ;

stored-declared-type
    ::= type-inference-hole
      | type-reference
      | stored-callable-type
      | reflected-type
      | stored-generic-type-application
      | stored-product-type
      ;

stored-callable-type
    ::= stored-callable-receiver , stored-callable-type-suffix ;

stored-callable-type-suffix
    ::= "." , callable-kind
        , "(" , [ stored-type-expression , { "," , stored-type-expression } ] , ")" ;

stored-callable-receiver
    ::= stored-nominal-type ;

stored-nominal-type
    ::= stored-generic-argument-head
        , { generic-constructor | stored-callable-type-suffix } ;

stored-generic-type-application
    ::= stored-explicit-generic-type-application | stored-postfix-generic-type-application ;

stored-explicit-generic-type-application
    ::= generic-constructor , "with" , stored-generic-argument-list ;

stored-postfix-generic-type-application
    ::= stored-generic-argument-head
        , { generic-constructor | stored-callable-type-suffix }
        , generic-constructor ;

stored-generic-argument-head
    ::= type-inference-hole | type-reference | stored-explicit-generic-type-application
      | reflected-type | stored-product-type
      | "(" , stored-generic-union-argument , ")" ;

stored-generic-argument-list
    ::= stored-generic-argument , { "," , stored-generic-argument } ;

stored-generic-argument
    ::= stored-generic-argument-head , { generic-constructor | stored-callable-type-suffix } ;

stored-generic-union-argument
    ::= stored-declared-type , { "|" , stored-declared-type } ;

stored-product-type
    ::= stored-positional-product-type
      | stored-named-product-type
      ;

stored-positional-product-type
    ::= "(" , stored-type-expression , "," , stored-type-expression
        , { "," , stored-type-expression } , ")"
      ;

stored-named-product-type
    ::= "(" , stored-named-product-component
        , "," , stored-named-product-component
        , { "," , stored-named-product-component } , ")"
      ;

stored-named-product-component
    ::= component-name , ":" , stored-type-expression ;

stored-dictionary-type
    ::= stored-dictionary-link , { stored-dictionary-link } ;

stored-dictionary-link
    ::= dictionary-arrow , stored-dictionary-value-type
        , [ collection-specification ]
      ;

stored-dictionary-value-type
    ::= stored-union-type-expression ;

type-expression
    ::= union-type-expression
        , ( { collection-specification } | dictionary-type )
        ;

union-type-expression
    ::= type-alternative , { "|" , type-alternative }
        ;

type-alternative
    ::= declared-type , [ "in" , type-alternative-domain ]
      | "(" , type-expression , ")"
        ;

type-alternative-domain
    ::= stepped-domain
      | interval-expression
      | collection-literal
      | qualified-name
      | "(" , domain-expression , ")"
        ;

declared-type
    ::= type-reference
      | callable-type
      | reflected-type
      | generic-type-application
      | product-type
      ;

callable-type
    ::= callable-receiver , callable-type-suffix ;

callable-type-suffix
    ::= "." , callable-kind
        , "(" , [ type-expression , { "," , type-expression } ] , ")" ;

callable-receiver
    ::= generic-argument-head
        , { generic-constructor | callable-type-suffix } ;

callable-kind
    ::= "action" | "rule" | "look" ;

reflected-type
    ::= postfix-expression , "~" , "type" ;

product-type
    ::= positional-product-type
      | named-product-type
      ;

positional-product-type
    ::= "(" , type-expression , "," , type-expression
        , { "," , type-expression } , ")"
      ;

named-product-type
    ::= "(" , named-product-component
        , "," , named-product-component
        , { "," , named-product-component } , ")"
      ;

named-product-component
    ::= component-name , ":" , type-expression ;

dictionary-type
    ::= dictionary-link , { dictionary-link } ;

dictionary-link
    ::= dictionary-arrow , dictionary-value-type
        , [ collection-specification ]
      ;

dictionary-arrow
    ::= "->" | "-->" ;

dictionary-value-type
    ::= union-type-expression ;

collection-specification
    ::= "["
        , ( cardinality
            , [ optional-comma , collection-modifier
                , { optional-comma , collection-modifier }
              ]
          | collection-modifier
            , { optional-comma , collection-modifier }
          )
        , "]"
        ;

cardinality
    ::= cardinality-bound
      | cardinality-bound , ".." , cardinality-bound
      ;

cardinality-bound
    ::= exact-integer | "*" ;

collection-modifier
    ::= "unique" , [ "by" , collection-key-path ]
      | "ordered" , [ "by" , collection-key-path ]
      | "mut"
      ;

optional-comma ::= [ "," ] ;

(* ------------------------------------------------------------------ *)
(* Participants, given and behaviour declarations                       *)
(* ------------------------------------------------------------------ *)

for-clause
    ::= "for" , for-participant , { "," , for-participant } ;

on-clause
    ::= "on" , on-participant , { "," , on-participant } ;

for-participant
    ::= [ "mut" ] , role-name , { "," , role-name } , ":" , type-expression
        , [ "{" , declaration-layout , [ metadata-assignment , { required-separation , metadata-assignment } , [ required-separation ] ] , "}" ]
        ;

on-participant
    ::= role-name , { "," , role-name } , ":" , type-reference , [ member-capability ] , [ "{" , declaration-layout , [ metadata-assignment , { required-separation , metadata-assignment } , [ required-separation ] ] , "}" ]
      | role-name , { "," , role-name } , [ ":" , type-reference ] , "in" , expression , [ member-capability ] , [ "{" , declaration-layout , [ metadata-assignment , { required-separation , metadata-assignment } , [ required-separation ] ] , "}" ]
      ;

member-capability
    ::= "[" , "mut" , "]" ;

given-clause
    ::= "given" , given-declaration , { "," , given-declaration } ;

given-declaration
    ::= given-name , { "," , given-name } , ":" , type-expression , [ "=" , constant-expression ]
        , [ "{" , declaration-layout , [ metadata-assignment , { required-separation , metadata-assignment } , [ required-separation ] ] , "}" ]
        ;

boolean-rule-declaration
    ::= "rule" , nominal-name
        , { generic-parameter-group }
        , [ for-clause ]
        , [ given-clause ]
        , boolean-body
        ;

boolean-body
    ::= "{" , declaration-layout
        , [ metadata-assignment
            , { required-separation , metadata-assignment }
            , required-separation
          ]
        , expression-block
        , [ required-separation ] , "}"
        ;

expression-block
    ::= { pure-preamble-statement , required-separation }
        , expression
        ;

value-body
    ::= value-expression , { otherwise-clause } | value-block-body ;

value-block-body
    ::= "{" , declaration-layout , value-block
        , [ required-separation ] , "}" , { otherwise-clause }
        ;

value-block
    ::= { value-statement , required-separation }
        , value-expression
        ;

value-statement
    ::= value-local-declaration
      | local-mutation
      | local-for-each
      | foreign-block
      | raise-statement
      ;

value-local-declaration
    ::= local-calculated-declaration
      | local-stored-declaration
      | local-pattern-declaration
      ;

local-calculated-declaration
    ::= "let" , variable-name , [ derived-value-shape ] , ":=" , value-body ;

local-stored-declaration
    ::= ( "let" | "mut" ) , variable-name , [ stored-value-shape ]
        , "=" , value-body ;

local-mutation
    ::= local-assignment
      | local-add
      | local-remove
      ;

local-assignment
    ::= assignable-expression , assignment-operator , value-expression ;

local-add
    ::= "add" , expression , "to" , assignable-expression ;

local-remove
    ::= "remove" , expression , "from" , assignable-expression ;

local-for-each
    ::= "foreach" , iteration-binding , "in" , expression
        , [ "by" , expression ]
        , [ "if" , expression-body ]
        , ":"
        , [ required-separation ]
        , ( value-statement | local-statement-block )
        ;

local-statement-block
    ::= "{" , declaration-layout
        , value-statement
        , { required-separation , value-statement }
        , [ required-separation ]
        , "}"
        ;

reactive-rule-declaration
    ::= "rule" , nominal-name
        , [ on-clause ]
        , "{" , declaration-layout
        , [ metadata-assignment , { required-separation , metadata-assignment } , required-separation ]
        , { behaviour-preamble-statement , required-separation }
        , when-clause
        , required-separation
        , [ if-clause , required-separation ]
        , then-clause
        , [ required-separation ]
        , "}"
        ;

always-rule-declaration
    ::= "always" , "rule" , nominal-name
        , [ on-clause ]
        , invariant-body
        , { otherwise-clause }
        ;

invariant-body
    ::= "{" , declaration-layout
        , [ metadata-assignment , { required-separation , metadata-assignment } , required-separation ]
        , expression-block
        , [ required-separation ]
        , "}"
        ;

action-declaration
    ::= "action" , action-signature-body ;

subaction-declaration
    ::= "subaction" , action-signature-body ;

action-signature-body
    ::= nominal-name
        , { generic-parameter-group }
        , [ for-clause ]
        , [ given-clause ]
        , "{" , declaration-layout
        , [ metadata-assignment , { required-separation , metadata-assignment } , required-separation ]
        , { behaviour-preamble-statement , required-separation }
        , [ action-if-clause , required-separation ]
        , then-clause
        , [ required-separation , action-after-clause ]
        , [ required-separation ]
        , "}"
        ;

look-declaration
    ::= "look" , look-signature-body ;

sublook-declaration
    ::= "sublook" , look-signature-body ;

look-signature-body
    ::= nominal-name
        , { generic-parameter-group }
        , [ for-clause ]
        , [ given-clause ]
        , "{" , declaration-layout
        , [ metadata-assignment , { required-separation , metadata-assignment } , required-separation ]
        , [ public-field-declaration
            , { required-separation , public-field-declaration }
            , [ required-separation ]
          ]
        , "}"
        ;

message-declaration
    ::= "message" , message-signature-body ;

submessage-declaration
    ::= "submessage" , message-signature-body ;

message-signature-body
    ::= nominal-name
        , [ on-clause ]
        , "{" , declaration-layout
        , [ metadata-assignment , { required-separation , metadata-assignment } , required-separation ]
        , { behaviour-preamble-statement , required-separation }
        , when-clause
        , [ required-separation , if-clause ]
        , [ required-separation , public-field-declaration
            , { required-separation , public-field-declaration }
          ]
        , [ required-separation ]
        , "}"
        ;

when-clause
    ::= "when" , expression-body ;

if-clause
    ::= "if" , expression-body ;

action-if-clause
    ::= "if" , expression-body ;

action-after-clause
    ::= "after" , expression-body ;

otherwise-clause
    ::= [ required-separation ] , "otherwise"
        , ( "raise" , value-body
          | [ on-clause ] , recovery-handler-body ) ;

recovery-handler-body
    ::= recovery-branch
      | "{" , declaration-layout
        , [ if-clause , required-separation ]
        , recovery-branch , [ required-separation ] , "}" ;

recovery-branch
    ::= "then" , recovery-body
      | "raise" , value-body ;

recovery-body
    ::= expression-body | value-block-body | effect-block | effect ;

expression-body
    ::= ( expression
        | "{" , declaration-layout , expression-block
          , [ required-separation ] , "}" )
        , { otherwise-clause }
      ;

then-clause
    ::= "then" , ( effect , { otherwise-clause } | effect-block ) ;

effect-block
    ::= "{" , declaration-layout
        , then-statement
        , { required-separation , then-statement }
        , [ required-separation ]
        , "}" , { otherwise-clause }
        ;

then-statement
    ::= effect
      | value-local-declaration
      ;

behaviour-preamble-statement
    ::= local-calculated-declaration
      | immutable-local-stored-declaration
      | local-pattern-declaration
      | foreign-block
        ;

immutable-local-stored-declaration
    ::= "let" , variable-name , [ stored-value-shape ] , "=" , value-body ;

local-pattern-declaration
    ::= "let" , positional-binding-pattern , ( "=" | ":=" ) , value-body ;

pure-pattern-declaration
    ::= "let" , positional-binding-pattern , ":=" , value-expression , { otherwise-clause } ;

binding-pattern
    ::= variable-name | "_" | positional-binding-pattern ;

positional-binding-pattern
    ::= "(" , binding-pattern , "," , binding-pattern
        , { "," , binding-pattern } , ")" ;

pure-preamble-statement
    ::= local-value-declaration | pure-pattern-declaration | foreign-block ;

foreign-block
    ::= "from" , foreign-language-name , foreign-body ;

foreign-language-name
    ::= nominal-name ;

foreign-body
    ::= foreign-item
      | "{" , declaration-layout , foreign-item
          , { required-separation , foreign-item }
          , [ required-separation ] , "}"
      ;

foreign-item
    ::= foreign-code-statement | foreign-value-export ;

foreign-code-statement
    ::= FOREIGN_STATEMENT ;

foreign-value-export
    ::= "mud" , variable-name , [ ":" , type-expression ]
        , "<-" , foreign-code-expression
        ;

foreign-code-expression
    ::= FOREIGN_EXPRESSION ;

local-value-declaration
    ::= "let" , variable-name , [ derived-value-shape ] , ":=" , value-expression , { otherwise-clause } ;

(* ------------------------------------------------------------------ *)
(* Initial activation and tests                                         *)
(* ------------------------------------------------------------------ *)

part-start-declaration
    ::= start-with-declaration ;

start-with-declaration
    ::= "start" , "with"
        , ( expression | start-contribution-body )
        ;

start-contribution-body
    ::= "{" , declaration-layout
        , expression
        , { "," , declaration-layout , expression }
        , [ "," ]
        , declaration-layout , "}"
        ;

test-declaration
    ::= "test" , nominal-name
        , "{" , declaration-layout
        , [ metadata-assignment , { required-separation , metadata-assignment } , required-separation ]
        , start-with-declaration
        , required-separation
        , then-clause
        , required-separation
        , test-after-clause
        , [ required-separation ]
        , "}"
        ;

test-after-clause
    ::= "after" , test-assertion
      | "after" , "{"
          , declaration-layout
          , { pure-preamble-statement , required-separation }
          , test-assertion
          , { required-separation , test-assertion }
          , [ required-separation ]
          , "}"
      ;

test-assertion
    ::= expression-body ;

(* ------------------------------------------------------------------ *)
(* Efectos                                                             *)
(* ------------------------------------------------------------------ *)

effect
    ::= foreign-block
      | assignment-effect
      | add-effect
      | remove-effect
      | create-effect
      | destroy-effect
      | action-call-effect
      | for-each-effect
      | raise-effect
      ;

raise-expression ::= "raise" , value-body ;
raise-effect ::= raise-expression ;
raise-statement ::= raise-expression ;

assignment-effect
    ::= assignable-expression , assignment-operator , value-expression ;

assignment-operator
    ::= "=" | "+=" | "-=" | "*=" | "/="
      | "|=" | "&=" | "^=" | "--="
      ;

add-effect
    ::= "add" , expression , "to" , assignable-expression ;

remove-effect
    ::= "remove" , expression , "from" , assignable-expression ;

create-effect
    ::= "create" , declaration-reference ;

destroy-effect
    ::= "destroy" , declaration-reference ;

action-call-effect
    ::= postfix-expression ;

for-each-effect
    ::= "foreach" , iteration-binding , "in" , expression
        , [ "by" , expression ]
        , [ "if" , expression-body ]
        , ":"
        , [ required-separation ]
        , ( effect | effect-block )
        ;

iteration-binding
    ::= binding-pattern ;

assignable-expression
    ::= primary-expression , { member-access | index-access } ;

(* ------------------------------------------------------------------ *)
(* Expresiones                                                         *)
(* ------------------------------------------------------------------ *)

expression
    ::= mapping-expression ;

mapping-expression
    ::= mapping-left , [ mapping-arrow , mapping-right ]
      | selector-expression , "-->" , mapping-right ;

selector-expression
    ::= selector-and , { "or" , selector-and } ;

selector-and
    ::= selector-term , { "and" , selector-term } ;

selector-term
    ::= "not" , selector-term
      | selector-comparison , comparison-expression
      | "is" , [ "not" ] , declared-type
      | "iis" , [ "not" ] , declared-type
      | comparison-expression
      | "(" , selector-expression , ")" ;

selector-comparison
    ::= "==" | "!=" | "<" | "<=" | ">" | ">=" ;

mapping-left
    ::= eventually-expression
      | mapping-key-body
      ;

mapping-key-body
    ::= "{" , declaration-layout , expression-block
        , [ required-separation ] , "}" , { otherwise-clause }
        ;

mapping-right
    ::= mapping-expression , { otherwise-clause }
      | value-block-body
      ;

mapping-arrow
    ::= "->" | "-->" ;

value-expression
    ::= expression , [ "," , expression , { "," , expression } ] ;



constant-expression
    ::= value-expression ;

domain-expression
    ::= expression ;

stepped-domain
    ::= interval-expression , "by" , constant-expression ;

eventually-expression
    ::= biconditional-expression
      | "eventually" , biconditional-expression , "through" , action-reference-list
      ;

action-reference-list
    ::= action-reference , { "," , action-reference }
      | "[" , action-reference , { "," , action-reference } , "]"
      ;

action-reference
    ::= qualified-name
      | receiver-tuple , "." , qualified-name
      ;

biconditional-expression
    ::= implication-expression
        , { biconditional-operator , implication-expression }
        ;

biconditional-operator
    ::= "<=>" ;

implication-expression
    ::= xor-expression , [ implication-operator , implication-expression ] ;

implication-operator
    ::= "=>" ;

xor-expression
    ::= or-expression , { xor-operator , or-expression } ;

xor-operator
    ::= "xor" | "^" ;

or-expression
    ::= and-expression , { or-operator , and-expression } ;

or-operator
    ::= "or" | "|" ;

and-expression
    ::= change-expression , { and-operator , change-expression } ;

and-operator
    ::= "and" | "&" ;

change-expression
    ::= comparison-expression , [ "changes" ] ;

comparison-expression
    ::= restriction-expression , [ comparison-tail ]
      | structural-type-comparison ;

restriction-expression
    ::= quantitative-expression , [ "in" , type-alternative-domain ] ;

comparison-tail
    ::= chainable-comparison , quantitative-expression
        , { chainable-comparison , quantitative-expression }
      | nonchainable-comparison , quantitative-expression
      ;

chainable-comparison
    ::= "==" | "<" | "<=" | ">" | ">=" ;

nonchainable-comparison
    ::= "!="
      | "is" , [ "not" ]
      | "iis" , [ "not" ]
      | membership-has
      ;

membership-has
    ::= "has" , [ "not" ] ;

(* quantitative-expression admits postfix to/in barriers. The parser
   applies the table from 08-concrete-grammar and continues over the result. *)
quantitative-expression
    ::= arithmetic-expression
        , { conversion-suffix , [ arithmetic-continuation ] }
        ;

conversion-suffix
    ::= "to" , nominal-type
      | "in" , unit-expression
      ;

arithmetic-continuation
    ::= arithmetic-operator , arithmetic-expression ;

arithmetic-operator
    ::= "+" | "-" | "--" | "*" | "/" | "%" ;

arithmetic-expression
    ::= multiplicative-expression
        , { ( "+" | "-" | "--" ) , multiplicative-expression }
        ;

multiplicative-expression
    ::= prefix-expression
        , { ( "*" | "/" | "%" ) , prefix-expression }
        ;

prefix-expression
    ::= { prefix-operator } , postfix-expression ;

prefix-operator
    ::= "not" | "+" | "-" | "old" | "imagine" | "all" ;

postfix-expression
    ::= primary-expression
        , { member-access | metadata-access | index-access | call-arguments | collection-transform-suffix | generic-call-suffix | expression-generic-suffix }
        ;

collection-transform-suffix
    ::= "[" , local-collection-transform , "]" ;

local-collection-transform
    ::= cardinality-bound , ".." , cardinality-bound
        , [ optional-comma , local-collection-modifier , { optional-comma , local-collection-modifier } ]
      | cardinality-bound , optional-comma , local-collection-modifier , { optional-comma , local-collection-modifier }
      | local-collection-modifier , { optional-comma , local-collection-modifier }
      ;

local-collection-modifier
    ::= "unique" , [ "by" , collection-key-path ]
      | "ordered" , [ "by" , collection-key-path ]
      ;

member-access
    ::= "." , identifier ;

metadata-access
    ::= "~" , metadata-name ;

index-access
    ::= "[" , expression , { "," , expression } , "]" ;

call-arguments
    ::= "(" , [ call-argument , { "," , call-argument } ] , ")" ;

call-argument
    ::= [ given-name , "=" ] , expression ;

receiver-tuple
    ::= "(" , receiver-entry , "," , receiver-entry
        , { "," , receiver-entry } , ")"
        ;

receiver-entry
    ::= expression
      | role-name , "=" , expression
      ;

primary-expression
    ::= generic-family-member
      | explicit-generic-type-application
      | grouped-postfix-generic-type-application
      | literal
      | take-expression
      | raise-expression
      | selection-expression
      | comprehension-expression
      | implicit-member-expression
      | qualified-name
      | structural-literal
      | collection-literal
      | interval-expression
      | quantity-expression
      | point-component-expression
      | quantifier-expression
      | random-expression
      | "thing" | "alias" | "family" | "magnitude" | "rule"
      | "action" | "subaction" | "look" | "sublook" | "message" | "submessage" | "test"
      | "(" , expression , ")"
      ;

take-expression
    ::= "take" , expression , "from" , expression ;

comprehension-expression
    ::= "foreach" , iteration-binding , "in" , expression
        , [ "by" , expression ] , [ "if" , expression-body ]
        , "-->" , [ required-separation ] , value-body ;

implicit-member-expression
    ::= "." , identifier ;

selection-expression
    ::= iteration-binding , "in" , expression
        , [ "by" , expression ]
        , ":" , [ required-separation ] , expression-body
        ;

point-component-expression
    ::= unit-expression , "from" , unit-expression
        , "in" , postfix-expression
        ;

literal
    ::= exact-number
      | rumber-number
      | text-template
      | POINT_LITERAL
      | "true"
      | "false"
      | "empty"
      | "all"
      | "_"
      ;

text-template
    ::= TEXT_START
        , { TEXT_FRAGMENT | value-interpolation }
        , TEXT_END
        ;

value-interpolation
    ::= INTERPOLATION_START
        , ( expression | contextual-point-component )
        , [ numeric-text-format ]
        , INTERPOLATION_END
        ;

contextual-point-component
    ::= unit-expression , "from" , unit-expression ;

numeric-text-format
    ::= ":" , exact-integer , [ ":" , exact-integer ]
      | ":" , ":" , exact-integer
      ;


exact-number  ::= EXACT_NUMBER_LITERAL ;
rumber-number ::= RUMBER_LITERAL ;
exact-integer ::= EXACT_INTEGER_LITERAL ;

structural-literal
    ::= "(" , ( positional-structural-elements | named-structural-elements ) , ")" ;

positional-structural-elements
    ::= expression , "," , expression , { "," , expression } ;

named-structural-elements
    ::= named-structural-element , { "," , named-structural-element } ;

named-structural-element
    ::= component-name , "=" , expression ;

collection-literal
    ::= "[" , [ expression , { "," , expression } ] , "]" ;

quantity-expression
    ::= ( exact-number | rumber-number ) , unit-expression ;

unit-expression
    ::= unit-factor , { ( "*" | "/" ) , unit-factor } ;

unit-factor
    ::= UNIT_FORM
      | identifier
      | "(" , unit-expression , ")"
      ;

random-expression
    ::= "Rand" , "(" , expression , ")" ;

quantifier-expression
    ::= quantifier , iteration-binding , "in" , expression
        , [ "by" , expression ]
        , ":" , [ required-separation ] , expression-body
        ;

quantifier
    ::= "exists" | "forall" | "count" | "min" | "max" ;

(* ------------------------------------------------------------------ *)
(* Intervals                                                           *)
(* ------------------------------------------------------------------ *)

interval-expression
    ::= shared-unit-interval
      | bounded-interval
      | closed-interval-sugar
      | singleton-interval
      ;

shared-unit-interval
    ::= shared-unit-bounded-interval , unit-expression
      | shared-unit-closed-interval , unit-expression
      | shared-unit-singleton-interval , unit-expression
      | "[" , "]" , unit-expression
      ;

shared-unit-bounded-interval
    ::= "[" , shared-unit-bound , ".." , shared-unit-bound , "]"
      | "(" , finite-shared-unit-bound , ".."
        , finite-shared-unit-bound , ")"
      | "[" , shared-unit-bound , ".."
        , finite-shared-unit-bound , ")"
      | "(" , finite-shared-unit-bound , ".."
        , shared-unit-bound , "]"
      ;

shared-unit-closed-interval
    ::= shared-unit-bound , ".." , shared-unit-bound ;

shared-unit-singleton-interval
    ::= "[" , shared-unit-bound , "]" ;

shared-unit-bound
    ::= finite-shared-unit-bound | "*" ;

finite-shared-unit-bound
    ::= [ "+" | "-" ] , ( exact-number | rumber-number ) ;

bounded-interval
    ::= "[" , interval-bound , ".." , interval-bound , "]"
      | "(" , finite-interval-bound , ".." , finite-interval-bound , ")"
      | "[" , interval-bound , ".." , finite-interval-bound , ")"
      | "(" , finite-interval-bound , ".." , interval-bound , "]"
      ;

closed-interval-sugar
    ::= interval-bound , ".." , interval-bound ;

singleton-interval
    ::= "[" , interval-bound , "]" ;

interval-bound
    ::= finite-interval-bound | "*" ;

finite-interval-bound
    ::= expression-without-interval ;

expression-without-interval
    ::= quantitative-expression ;

(* ------------------------------------------------------------------ *)
(* Physical separation                                                  *)
(* ------------------------------------------------------------------ *)

layout
    ::= { TERMINATOR } ;

declaration-layout
    ::= { TERMINATOR } ;

required-separation
    ::= TERMINATOR , { TERMINATOR } ;
