{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@r3nner/syntax-highlight-core": ["./packages/core/src/index.ts"],
      "@r3nner/syntax-highlight-language-mud": ["./packages/language-mud/src/index.ts"],
      "@r3nner/syntax-highlight-html": ["./packages/html/src/index.ts"],
      "@r3nner/syntax-highlight-codemirror": ["./packages/codemirror/src/index.ts"],
      "@r3nner/syntax-highlight-mcp": ["./packages/mcp/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "scripts/**/*.mjs", "vitest.config.ts"]
}
